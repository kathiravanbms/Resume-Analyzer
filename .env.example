# Supabase Auth — create a project at https://supabase.com/dashboard
# Project Settings → API. Both values are public (the anon key ships in the
# browser bundle); row-level security protects your data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
